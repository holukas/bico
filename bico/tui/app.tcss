/* Modern dark look. Colors come from Textual's design tokens so the UI stays
   coherent and adapts to the (dark) theme. Layout is fluid: the settings pane
   takes a clamped share of the width and the console fills the rest, so it
   reads well full-screen and when the terminal is small. */

Screen {
    layout: vertical;
    background: $background;
}

#body {
    height: 1fr;
}

/* ---- settings (left) ---- */

#settings {
    width: 38%;
    min-width: 42;
    max-width: 72;
    padding: 1 2 1 2;
    background: $surface;
    border-right: tall $primary 40%;
}

.section {
    margin: 1 0 0 0;
    padding: 0 0 0 0;
    color: $accent;
    text-style: bold;
    border-bottom: heavy $primary 30%;
}

.field {
    height: auto;
    margin: 1 0 0 0;
}

.field-label {
    color: $text-muted;
    padding: 0 0 0 1;
}

.field Input,
.field Select {
    width: 1fr;
}

/* path rows: input fills the line, Browse button sits at the right */
.path-row {
    height: auto;
}

.path-row Input {
    width: 1fr;
}

.browse-btn {
    width: auto;
    min-width: 12;
    margin: 0 0 0 1;
}

/* switch rows: label fills the line, switch sits at the right */
.field-switch {
    height: auto;
    align: left middle;
}

.field-switch .field-label {
    width: 1fr;
    padding: 1 0 0 1;
}

#actions {
    height: auto;
    margin: 2 0 1 0;
    align: center middle;
}

#actions Button {
    margin: 0 1;
    width: 1fr;
}

/* ---- console (right) ---- */

#console-pane {
    width: 1fr;
    padding: 1 2 1 2;
}

.pane-title {
    color: $accent;
    text-style: bold;
    padding: 0 0 1 1;
}

#console {
    height: 1fr;
    background: $panel;
    border: round $primary 50%;
    padding: 0 1;
    scrollbar-gutter: stable;
}

/* ---- directory picker modal ---- */

DirectoryPickerScreen {
    align: center middle;
    background: $background 60%;
}

#picker {
    width: 70%;
    height: 80%;
    min-width: 40;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

.picker-title {
    color: $accent;
    text-style: bold;
    padding: 0 0 1 0;
}

#picker-current {
    color: $text-muted;
    padding: 0 0 1 0;
}

#picker-tree {
    height: 1fr;
    background: $panel;
    border: round $primary 50%;
}

#picker-actions {
    height: auto;
    margin: 1 0 0 0;
    align: center middle;
}

#picker-actions Button {
    margin: 0 1;
}
