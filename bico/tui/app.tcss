/* Modern dark look. Colors come from Textual's design tokens so the UI stays
   coherent and adapts to the (dark) theme. Layout is fluid: the settings pane
   takes a clamped share of the width and the console fills the rest, so it
   reads well full-screen and when the terminal is small. */

Screen {
    layout: vertical;
    background: $background;
}

#body {
    height: 1fr;
}

/* ---- settings (left) ----
   Compact, scroll-free form: two side-by-side columns, one row per field
   (label + control on the same line, single cell tall). Borders are stripped
   from inputs to keep each field exactly one row high. */

/* Fixed-width settings pane sized to its two compact columns; the console
   takes all remaining width. This keeps settings tight even on very wide
   terminals, and degrades gracefully on narrow ones. */
#settings {
    width: 82;
    padding: 0 1;
    background: $surface;
    border-right: tall $primary 40%;
}

#settings-cols {
    width: 1fr;
    height: 1fr;
}

.settings-col {
    width: 39;
    height: auto;
    padding: 0 1;
}

.section {
    height: 1;
    margin: 1 0 0 0;
    color: $accent;
    text-style: bold;
}

.field {
    height: 1;
    align: left middle;
}

.field-label {
    width: 16;
    height: 1;
    color: $text-muted;
}

.field Input,
.field Select {
    width: 1fr;
    height: 1;
    border: none;
    background: $boost;
    padding: 0 1;
}

.field Input.-invalid {
    background: $error 30%;
}

.field Select SelectCurrent {
    border: none;
    padding: 0;
}

/* The dropdown overlay floats above everything, so let it size to its longest
   option instead of the narrow field width (otherwise option labels wrap). */
.field Select SelectOverlay {
    width: auto;
    min-width: 24;
    max-width: 40;
}

.field Switch {
    height: 1;
    border: none;
    padding: 0;
    background: $boost;
}

.browse-btn {
    width: 3;
    min-width: 3;
    height: 1;
    margin: 0;
    border: none;
}

#actions {
    height: auto;
    margin: 1 0 0 0;
    align: center middle;
}

#actions Button {
    width: auto;
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 2;
    margin: 0 1;
}

/* ---- console (right) ---- */

#console-pane {
    width: 1fr;
    padding: 1 2 1 2;
}

.pane-title {
    color: $accent;
    text-style: bold;
    padding: 0 0 1 1;
}

#console {
    height: 1fr;
    background: $panel;
    border: round $primary 50%;
    padding: 0 1;
    scrollbar-gutter: stable;
}

/* ---- help modal ---- */

HelpScreen {
    align: center middle;
    background: $background 60%;
}

#help {
    width: 84;
    max-width: 92%;
    height: 86%;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

.help-title {
    color: $accent;
    text-style: bold;
    padding: 0 0 1 0;
}

#help-body {
    height: 1fr;
    padding: 0 1;
    background: $panel;
    border: round $primary 50%;
}

#help-actions {
    height: auto;
    margin: 1 0 0 0;
    align: center middle;
}

/* ---- directory picker modal ---- */

DirectoryPickerScreen {
    align: center middle;
    background: $background 60%;
}

#picker {
    width: 70%;
    height: 80%;
    min-width: 40;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

.picker-title {
    color: $accent;
    text-style: bold;
    padding: 0 0 1 0;
}

#picker-path {
    width: 1fr;
    margin: 0 0 1 0;
}

#picker-tree {
    height: 1fr;
    background: $panel;
    border: round $primary 50%;
}

#picker-actions {
    height: auto;
    margin: 1 0 0 0;
    align: center middle;
}

#picker-actions Button {
    margin: 0 1;
}
