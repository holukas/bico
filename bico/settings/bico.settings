# ==========================================================================
# bico.settings - configuration for the bico binary converter
# ==========================================================================
# Read by the TUI (uv run bico -t) and the headless CLI (uv run bico -f ...).
# This is the canonical layout: Export and the per-run snapshot written to each
# output folder use the exact same structure. Lines are "key=value"; lines
# starting with "#" are comments. Only the keys below are recognised; anything
# else is ignored when read and dropped when the file is rewritten.

# INSTRUMENTS
# ===========

# Site
site=CH-LAE

# Data blocks (logger header + the sonic and up to two gas analyzers, in order)
header=WECOM3
instrument_1=HS50-B
instrument_2=IRGA72-A
instrument_3=-None-

# RAW DATA
# ========

# Folder with the binary files (searched recursively)
dir_source=F:\CURRENT\LAE_FP2026\2026\1-BICO\bin

# Time range, both ends inclusive (YYYY-MM-DD HH:MM)
start_date=2025-12-31 19:00
end_date=2026-09-30 19:00

# Filename datetime format (incl. extension); also selects which files match
filename_datetime_format=yyyymmddHH.LMM

# File selection (0 = no limit / no minimum / no random selection)
file_size_min=900
file_limit=0
row_limit=0
select_random_files=0

# OUTPUT
# ======

# Folder the converted files are written to
dir_out=F:\CURRENT\LAE_FP2026\2026\1-BICO

# Run output folder name prefix
output_folder_name_prefix=CH-LAE_2026.09

# Output format
file_compression=gzip
num_processes=1
add_instr_to_varname=1

# Plots generated per run
plot_file_availability=1
plot_ts_hires=1
plot_histogram_hires=0
plot_ts_agg=1
